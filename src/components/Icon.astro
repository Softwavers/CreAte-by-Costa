  flame: '<path d="M12 21c-3.3 0-6-2.4-6-5.6 0-3.6 3-5.4 4-9.4 2.6 1.8 3 4 3 5.4 1-.6 1.8-1.8 2-3 1.6 1.6 3 4 3 7 0 3.2-2.7 5.6-6 5.6z"/>',
  gift: '<rect x="4" y="9" width="16" height="11" rx="2"/><path d="M3 9h18v3H3zM12 9v11M12 9c-1.5-3-5-3.5-5-1.5S10 9 12 9zm0 0c1.5-3 5-3.5 5-1.5S14 9 12 9z"/>',
