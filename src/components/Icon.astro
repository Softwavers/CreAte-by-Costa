const { name, size = 22, class: cls = '' } = Astro.props;
const paths: Record<Props['name'], string> = {
  bag: '<path d="M5 8h14l-1.2 11.2a2 2 0 0 1-2 1.8H8.2a2 2 0 0 1-2-1.8L5 8z"/><path d="M9 10V6.5a3 3 0 0 1 6 0V10"/>',
