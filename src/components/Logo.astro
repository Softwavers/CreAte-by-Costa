---
// The CreAte by Costa logo, redrawn as a crisp SVG from the original artwork.
interface Props { class?: string; title?: string }
const { class: cls = '', title = 'CreAte by Costa' } = Astro.props;
---
<svg class={`logo ${cls}`} viewBox="0 0 220 150" role="img" aria-label={title} xmlns="http://www.w3.org/2000/svg">
  <path d="M30 70c-6-30 22-55 66-58 46-3 92 10 100 42 8 34-18 66-62 74-46 8-96-12-104-58z" fill="#dfb154"/>
  <path d="M18 92c-12-40 30-82 96-86 52-3 92 18 96 52" fill="none" stroke="#4a3a2c" stroke-width="1.6" stroke-linecap="round"/>
  <text x="104" y="84" text-anchor="middle" font-family="'Dancing Script', cursive" font-weight="600" font-size="52" fill="#fff">CreAte</text>
  <text x="150" y="112" text-anchor="middle" font-family="'Dancing Script', cursive" font-size="20" fill="#fff">by costa</text>
  <path d="M190 128l2.2 5 5 2.2-5 2.2-2.2 5-2.2-5-5-2.2 5-2.2z" fill="#4a3a2c"/>
  <path d="M206 126l1.4 3.2 3.2 1.4-3.2 1.4-1.4 3.2-1.4-3.2-3.2-1.4 3.2-1.4z" fill="#4a3a2c"/>
</svg>
