---
// Shows a product photo, or the illustrated candle until photos are added.
import type { Product } from '../data/products';
import CandleArt from './CandleArt.astro';
import { asset } from '../i18n/utils';

interface Props { product: Product; alt: string; index?: number; eager?: boolean; class?: string }
const { product, alt, index = 0, eager = false, class: cls = '' } = Astro.props;
const src = product.images[index];
---
{src ? (
  <img class={`product-img ${cls}`} src={asset(src)} alt={alt} loading={eager ? 'eager' : 'lazy'} decoding="async" width="800" height="800" />
) : (
  <CandleArt class={cls} art={product.art} label={alt} />
)}

<style>
  .product-img { width: 100%; height: 100%; object-fit: cover; }
</style>
