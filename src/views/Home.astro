---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import ProductImage from '../components/ProductImage.astro';
import Showcase from '../components/Showcase.astro';
import Icon from '../components/Icon.astro';
import { products } from '../data/products';
import { categories } from '../data/categories';
import { site } from '../config/site';
import { t, path, asset } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const featured = products.filter((p) => p.featured).slice(0, 4);
const why = [
  { icon: 'heart', color: 'pink', title: 'home.why.1.title', text: 'home.why.1.text' },
  { icon: 'flame', color: 'butter', title: 'home.why.2.title', text: 'home.why.2.text' },
  { icon: 'gift', color: 'lavender', title: 'home.why.3.title', text: 'home.why.3.text' },
  { icon: 'sparkle', color: 'mint', title: 'home.why.4.title', text: 'home.why.4.text' },
] as const;
const galleryArt = products.slice(0, 6);
---
<Base lang={lang} title={t(lang, 'seo.home.title')} description={t(lang, 'seo.home.desc')} current="home">
  <!-- Hero -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-text">
        <p class="eyebrow">{t(lang, 'home.hero.eyebrow')}</p>
        <p class="hero-brand" aria-hidden="true">Cre<span>A</span>te <small>by Costa</small></p>
        <h1>{t(lang, 'home.hero.title')}</h1>
        <p class="hero-sub">{t(lang, 'home.hero.subtitle')}</p>
        <div class="hero-ctas">
          <a class="btn btn-primary" href={path(lang, '/shop/')}>{t(lang, 'home.hero.cta')} <Icon name="arrow" size={18} /></a>
          <a class="btn btn-ghost" href={path(lang, '/our-story/')}>{t(lang, 'home.hero.cta2')}</a>
        </div>
        <p class="hero-tagline">{t(lang, 'home.hero.tagline')}</p>
      </div>
      <div class="hero-visual" aria-hidden="true">
        <div class="hero-blob"></div>
        <div class="hero-card hero-card-main"><Showcase index={0} /></div>
        <div class="hero-card hero-card-2"><Showcase index={1} /></div>
        <div class="hero-card hero-card-3"><Showcase index={2} /></div>
        <span class="sparkle" style="top:6%;left:12%;font-size:22px">✦</span>
        <span class="sparkle" style="bottom:10%;right:4%;font-size:16px;animation-delay:1.2s">✦</span>
        <span class="sparkle" style="top:42%;right:-2%;font-size:12px;animation-delay:2s">✦</span>
      </div>
    </div>
  </section>

  <!-- Featured -->
  <section class="section">
    <div class="wrap">
      <div class="section-head reveal">
        <h2>{t(lang, 'home.featured.title')}</h2>
        <p>{t(lang, 'home.featured.subtitle')}</p>
      </div>
      <div class="product-grid">
        {featured.map((p, i) => <div class="reveal" style={`transition-delay:${i * 80}ms`}><ProductCard product={p} lang={lang} /></div>)}
      </div>
      <div class="center-cta">
        <a class="btn btn-soft" href={path(lang, '/shop/')}>{t(lang, 'home.featured.all')} <Icon name="arrow" size={18} /></a>
      </div>
    </div>
  </section>

  <!-- Story teaser -->
  <section class="section story bg-cream">
    <div class="wrap story-grid">
      <div class="story-visual reveal" aria-hidden="true">
        <div class="story-frame bg-peach"><Showcase index={3} /></div>
        <div class="story-note">♡ handmade</div>
      </div>
      <div class="reveal">
        <p class="eyebrow">{t(lang, 'home.story.eyebrow')}</p>
        <h2>{t(lang, 'home.story.title')}</h2>
        <p class="lead">{t(lang, 'home.story.text')}</p>
        <a class="link" href={path(lang, '/our-story/')}>{t(lang, 'home.story.cta')} →</a>
      </div>
    </div>
  </section>

  <!-- Categories -->
  <section class="section">
    <div class="wrap">
      <div class="section-head reveal">
        <h2>{t(lang, 'home.categories.title')}</h2>
        <p>{t(lang, 'home.categories.subtitle')}</p>
      </div>
      <div class="cat-grid">
        {categories.map((c, i) => (
          <a class={`cat-card bg-${c.color} reveal`} style={`transition-delay:${i * 80}ms`} href={`${path(lang, '/shop/')}?category=${c.id}`}>
            <span class="cat-star" aria-hidden="true">✦</span>
            <h3>{c.name[lang]}</h3>
            <p>{c.description[lang]}</p>
            <span class="cat-arrow" aria-hidden="true"><Icon name="arrow" size={18} /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Why -->
  <section class="section why">
    <div class="wrap">
      <div class="section-head reveal"><h2>{t(lang, 'home.why.title')}</h2></div>
      <ul class="why-grid">
        {why.map((w, i) => (
          <li class="why-item reveal" style={`transition-delay:${i * 80}ms`}>
            <span class={`why-icon bg-${w.color}`}><Icon name={w.icon} size={26} /></span>
            <h3>{t(lang, w.title)}</h3>
            <p>{t(lang, w.text)}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Instagram / Our creations -->
  <section class="section insta bg-cream">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">{t(lang, 'home.insta.eyebrow')}</p>
        <h2>{t(lang, 'home.insta.title')}</h2>
        <p>{t(lang, 'home.insta.text')}</p>
      </div>
      <div class="insta-grid">
        {site.gallery.length
          ? site.gallery.slice(0, 6).map((src) => (
              <a class="insta-tile reveal" href={site.instagramUrl} target="_blank" rel="noopener">
                <img src={asset(src)} alt="" loading="lazy" width="600" height="600" />
              </a>
            ))
          : galleryArt.map((p) => (
              <a class="insta-tile reveal" href={site.instagramUrl} target="_blank" rel="noopener" aria-label={`${p.name[lang]} · Instagram`}>
                <ProductImage product={p} alt="" />
              </a>
            ))}
      </div>
      <div class="center-cta">
        <a class="btn btn-insta" href={site.instagramUrl} target="_blank" rel="noopener"><Icon name="instagram" size={20} /> {t(lang, 'home.insta.cta')}</a>
        <p class="muted handle">{site.instagramHandle}</p>
      </div>
    </div>
  </section>

  {site.testimonials.length > 0 && (
    <section class="section">
      <div class="wrap">
        <div class="section-head reveal"><h2>{t(lang, 'home.reviews.title')}</h2></div>
        <div class="reviews">
          {site.testimonials.map((r) => (
            <figure class="review reveal">
              <blockquote>“{r.quote[lang]}”</blockquote>
              <figcaption>— {r.name}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Final CTA -->
  <section class="section final">
    <div class="wrap">
      <div class="final-card reveal">
        <span class="sparkle" style="top:18%;left:8%;font-size:20px" aria-hidden="true">✦</span>
        <span class="sparkle" style="bottom:20%;right:10%;font-size:14px;animation-delay:1.5s" aria-hidden="true">✦</span>
        <h2>{t(lang, 'home.final.title')}</h2>
        <p>{t(lang, 'home.final.text')}</p>
        <a class="btn btn-dark" href={path(lang, '/shop/')}>{t(lang, 'home.final.cta')} <Icon name="arrow" size={18} /></a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { position: relative; overflow: hidden; padding: clamp(32px, 6vw, 80px) 0 clamp(48px, 8vw, 100px); }
  .hero-grid { display: grid; grid-template-columns: 1.05fr 1fr; gap: clamp(32px, 5vw, 72px); align-items: center; }
  .hero-brand {
    font-family: var(--font-script); font-weight: 600; font-size: clamp(2.4rem, 5vw, 3.4rem);
    line-height: 1; margin: 0 0 18px; color: var(--gold-deep);
  }
  .hero-brand span { color: var(--pink-deep); }
  .hero-brand small { font-size: 0.48em; color: var(--ink-soft); font-weight: 500; }
  .hero h1 { margin-bottom: 18px; }
  .hero-sub { font-size: 1.12rem; color: var(--ink-soft); max-width: 520px; }
  .hero-ctas { display: flex; flex-wrap: wrap; gap: 12px; margin: 28px 0 22px; }
  .hero-tagline { font-family: var(--font-display); font-style: italic; color: var(--ink-soft); font-size: 1.02rem; max-width: 460px; padding-left: 16px; border-left: 2px solid var(--gold); }
  .hero-visual { position: relative; aspect-ratio: 1 / 1.02; max-width: 540px; width: 100%; justify-self: center; }
  .hero-blob {
    position: absolute; inset: 6% 2% 4% 6%;
    background: var(--gold); opacity: 0.9;
    border-radius: 58% 42% 50% 50% / 46% 52% 48% 54%;
    animation: morph 14s ease-in-out infinite;
  }
  @keyframes morph {
    50% { border-radius: 44% 56% 42% 58% / 56% 44% 56% 44%; }
  }
  .hero-card { position: absolute; border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow); border: 6px solid var(--white); }
  .hero-card-main { inset: 14% 22% 18% 14%; transform: rotate(-3deg); }
  .hero-card-2 { width: 36%; aspect-ratio: 1; right: 0; top: 8%; transform: rotate(5deg); }
  .hero-card-3 { width: 34%; aspect-ratio: 1; right: 6%; bottom: 2%; transform: rotate(-4deg); }

  .product-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
  .product-grid > div { display: flex; }
  .product-grid > div > :global(*) { flex: 1; }
  .center-cta { text-align: center; margin-top: 40px; }

  .story-grid { display: grid; grid-template-columns: 1fr 1.1fr; gap: clamp(32px, 6vw, 88px); align-items: center; }
  .story-visual { position: relative; max-width: 440px; }
  .story-frame { aspect-ratio: 4 / 5; border-radius: 200px 200px var(--radius-lg) var(--radius-lg); overflow: hidden; box-shadow: var(--shadow); }
  .story-note {
    position: absolute; right: -12px; bottom: 28px; transform: rotate(-6deg);
    background: var(--white); padding: 10px 18px; border-radius: 999px; box-shadow: var(--shadow-sm);
    font-family: var(--font-script); font-size: 1.4rem; color: var(--pink-deep);
  }
  .lead { font-size: 1.1rem; color: var(--ink-soft); }

  .cat-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .cat-card {
    position: relative; display: flex; flex-direction: column; min-height: 220px;
    padding: 28px 24px; border-radius: var(--radius-lg); text-decoration: none;
    transition: transform 0.35s var(--ease), box-shadow 0.35s var(--ease);
  }
  .cat-card:hover { transform: translateY(-4px) rotate(-0.5deg); box-shadow: var(--shadow); }
  .cat-card h3 { font-size: 1.45rem; margin-top: auto; }
  .cat-card p { color: var(--ink-soft); font-size: 0.92rem; margin: 0; }
  .cat-star { color: var(--gold-deep); font-size: 1.2rem; }
  .cat-arrow {
    position: absolute; top: 22px; right: 22px; width: 38px; height: 38px; border-radius: 50%;
    display: grid; place-items: center; background: rgb(255 255 255 / 0.7);
    transition: transform 0.3s var(--ease);
  }
  .cat-card:hover .cat-arrow { transform: translateX(4px); }

  .why-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
  .why-item { text-align: center; padding: 8px 12px; }
  .why-icon { display: inline-grid; place-items: center; width: 68px; height: 68px; border-radius: 24px; margin-bottom: 16px; color: var(--ink); transform: rotate(-4deg); }
  .why-item h3 { font-size: 1.2rem; }
  .why-item p { color: var(--ink-soft); font-size: 0.95rem; }

  .insta-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 12px; }
  .insta-tile { display: block; aspect-ratio: 1; border-radius: var(--radius); overflow: hidden; transition: transform 0.35s var(--ease), box-shadow 0.35s; }
  .insta-tile:nth-child(even) { transform: translateY(14px); }
  .insta-tile:hover { transform: translateY(-4px); box-shadow: var(--shadow); }
  .insta-tile img { width: 100%; height: 100%; object-fit: cover; }
  .handle { margin-top: 10px; font-weight: 600; }

  .reviews { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 20px; }
  .review { margin: 0; background: var(--white); border-radius: var(--radius); padding: 28px; box-shadow: var(--shadow-sm); }
  .review blockquote { margin: 0 0 12px; font-family: var(--font-display); font-style: italic; font-size: 1.15rem; }
  .review figcaption { color: var(--ink-soft); font-weight: 700; }

  .final-card {
    position: relative; overflow: hidden; text-align: center;
    background: linear-gradient(135deg, var(--pink), var(--lavender) 55%, var(--blue));
    border-radius: var(--radius-lg); padding: clamp(48px, 8vw, 88px) clamp(20px, 6vw, 80px);
  }
  .final-card p { max-width: 560px; margin: 0 auto 28px; color: var(--ink-soft); font-size: 1.05rem; }

  @media (max-width: 1024px) {
    .product-grid, .cat-grid { grid-template-columns: repeat(2, 1fr); }
    .why-grid { grid-template-columns: repeat(2, 1fr); }
    .insta-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 820px) {
    .hero-grid, .story-grid { grid-template-columns: 1fr; }
    .hero-visual { max-width: 420px; order: -1; }
    .story-visual { margin-inline: auto; width: 80%; }
  }
  @media (max-width: 560px) {
    .product-grid { grid-template-columns: 1fr; }
    .cat-grid { grid-template-columns: 1fr 1fr; gap: 12px; }
    .cat-card { min-height: 180px; padding: 20px 16px; }
    .cat-card h3 { font-size: 1.15rem; }
    .cat-arrow { display: none; }
    .why-grid { grid-template-columns: 1fr 1fr; gap: 16px; }
    .insta-grid { gap: 8px; }
    .hero-ctas .btn { flex: 1 1 100%; }
  }
</style>
